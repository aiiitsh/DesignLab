[
  {
    "id": "candy",
    "title": "Candy choice-overload replication (group project)",
    "subtitle": "Iyengar & Lepper (2000) Study 3 with candy: 6 vs 30 options, between-subjects, n = 13 per group",
    "lane": "A",
    "file": "candy.csv",
    "analysis_id": "ttest_ind",
    "roles": {"dv": "Q1", "factors_between": ["group"]},
    "dvs": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "time"],
    "column_types": {"id": "nominal", "group": "nominal", "item": "nominal", "made": "nominal", "tasted": "nominal",
                     "Q1": "ordinal", "Q2": "ordinal", "Q3": "ordinal", "Q4": "ordinal", "Q5": "ordinal", "Q6": "ordinal", "time": "scale"},
    "dv_labels": {"Q1": "decision difficulty", "Q2": "process satisfaction", "Q3": "confidence", "Q4": "satisfaction after tasting",
                  "Q5": "regret", "Q6": "wanting more kinds", "time": "decision time (s)"},
    "options": {"level_labels": {"A": "limited-choice (6 items)", "B": "extensive-choice (30 items)"},
                "level_short": {"A": "limited choice", "B": "extensive choice"}, "dv_label": "decision difficulty"},
    "wizard": {
      "plan_rq": "Does a larger choice set (30 items) change difficulty, satisfaction, confidence, regret and decision time compared with a small set (6 items)?",
      "plan_hyp": "two",
      "plan_vars": {
        "ivs": [{"name": "Number of options", "levels": ["A: 6 items (limited)", "B: 30 items (extensive)"], "role": "between", "type": "nominal"}],
        "dvs": [{"name": "Q1 difficulty", "type": "ordinal (1–7, treated as interval)"}, {"name": "Q2 process satisfaction", "type": "ordinal"},
                {"name": "Q3 confidence", "type": "ordinal"}, {"name": "Q4 satisfaction after tasting", "type": "ordinal"},
                {"name": "Q5 regret", "type": "ordinal"}, {"name": "Q6 should the display have included more kinds?", "type": "ordinal"},
                {"name": "Decision time", "type": "ratio", "unit": "s"}],
        "controls": "Same candy brand family, same instructions, one display per participant"
      },
      "plan_manip": "quasi",
      "plan_controls": ["randomize", "practice"],
      "lane": "A", "A_niv": "1", "A_levels": "2", "A_within2": "between"
    },
    "notes": ["Quasi-random classroom sample: weaker causal claim.", "Likert DVs and n = 13 per group: Mann-Whitney U is the course fallback.",
              "Participant 26 has no decision time; it is excluded and reported.", "Every participant made a choice and tasted, so 'made a choice × group' has no variation and cannot be tested with χ²."],
    "power": {"family": "ttest_ind", "posthoc": {"es": 0.957, "n1": 13, "n2": 13}, "time_posthoc": {"es": 1.4, "n1": 12, "n2": 13}},
    "paper_comparison": {
      "title": "Compared with Iyengar & Lepper (2000), Study 3",
      "replicated": ["Choosing from the extensive set was more difficult (Q1), significant before correction.", "Decision time was much longer with 30 items (significant, survives Bonferroni)."],
      "not_replicated": ["Satisfaction after tasting (Q4) was not lower with extensive choice (in the paper it was).", "Regret (Q5) did not differ between the groups."],
      "extra": ["The limited-choice group wanted more kinds on the display (Q6), which the paper did not measure in this form."],
      "caveat": "n = 13 per group gives power ≈ .65 even for the observed Q1 effect (d ≈ 0.96); the study was underpowered for medium effects."
    }
  },
